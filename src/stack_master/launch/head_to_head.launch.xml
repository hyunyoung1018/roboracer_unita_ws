<?xml version="1.0"?>
<!--
  Head-to-head mode. This file is deliberately independent from
  time_trials.launch.xml so the proven time-trials graph remains unchanged.

  Static:  tracking -> stable router -> existing spline -> static_otwpnts
  Dynamic: tracking -> stable router -> GP prediction -> lane change -> otwpnts
-->
<launch>
  <arg name="map" description="Map name (folder under stack_master/maps/)"/>
  <arg name="localization" default="true"
       description="Bring up localization and hardware; false if already running."/>
  <!-- Overtaking runs on a constant-velocity prediction, not a learned one.
       Three booleans rather than one mode string, because ROS 2 launch XML has
       no string comparison (see base_system.launch.xml):

         prediction    opp_prediction, which turns the tracked opponent into
                       the PredictionArray the lane-change planner needs.
         gp_learning   the two nodes that learn the opponent's line -
                       opponent_trajectory and gaussian_process_opp_traj.
                       Off: opp_prediction finds no trajectory and falls back
                       to constant velocity from the tracker's own vs.
         dynamic_avoidance  the lane-change planner itself.

       Learned prediction is off because its authorization gate is close to
       unsatisfiable on a 21.9 m track, not because it is expensive - measured
       here, the GP refit is 1.5% of one core at 3 Hz. See
       authorize_on_fallback in opp_prediction.py.

       To get the original learned behaviour back:
         gp_learning:=true authorize_on_fallback:=false -->
  <arg name="prediction" default="true"
       description="Run opp_prediction (needed for any dynamic overtaking)."/>
  <arg name="gp_learning" default="false"
       description="Also learn the opponent's line with the GP pair."/>
  <arg name="authorize_on_fallback" default="true"
       description="Let a constant-velocity prediction authorize an overtake."/>
  <arg name="dynamic_avoidance" default="true"
       description="Run the UNICORN-derived lane-change planner."/>
  <arg name="relocalize" default="true"
       description="Re-seed the particle filter at the finish line every N laps."/>
  <arg name="relocalize_every_n_laps" default="3"
       description="How often. Live: ros2 param set /auto_relocalizer relocalize_every_n_laps N"/>

  <arg name="joy_max_speed" default="5.0"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="foxglove" default="false"/>

  <let name="config_dir" value="$(find-pkg-share stack_master)/config/car"/>
  <let name="map_dir" value="$(find-pkg-share stack_master)/maps/$(var map)"/>

  <group if="$(var localization)">
    <include file="$(find-pkg-share stack_master)/launch/localization.launch.xml">
      <arg name="map" value="$(var map)"/>
      <arg name="rviz" value="$(var rviz)"/>
      <arg name="foxglove" value="$(var foxglove)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="teleop" value="false"/>
    </include>
  </group>

  <!-- Raceline speed and overtaking permission. Existing ot_sectors.yaml is
       authoritative; this mode never forces permission true. -->
  <node pkg="sector_tuner" exec="sector_tuner" name="sector_tuner" output="screen">
    <param from="$(var map_dir)/speed_scaling.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="sector_tuner" exec="ot_interpolator" name="ot_interpolator" output="screen">
    <param from="$(var map_dir)/ot_sectors.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Existing perception and tracking remain untouched.  This head-to-head-only
       adapter stabilizes classification after tracking. -->
  <!-- dynamic_perception.yaml on the DETECTOR too. It was missing, and that
       is why the opponent behaved nothing like a static box: a 12 cm pillar
       against min_size_n 8 stops existing beyond 3.4 m, while the state
       machine here looks 8 to 9 m ahead. -->
  <node pkg="perception" exec="detect" name="detect" output="screen">
    <param from="$(var config_dir)/perception.yaml"/>
    <param from="$(var config_dir)/dynamic_perception.yaml"/>
    <param name="map" value="$(var map)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <!-- h2h_tracking_node, not tracking_node: a subclass that publishes the
       obstacle fields the shared tracker drops (x_m/y_m/theta and the
       variances) and sizes a confirmed-moving target like a car rather than
       like a static box. time_trials keeps running the unmodified
       tracking_node, and dynamic_perception.yaml only adds keys. -->
  <node pkg="perception" exec="h2h_tracking_node" name="tracking" output="screen">
    <param from="$(var config_dir)/perception.yaml"/>
    <param from="$(var config_dir)/dynamic_perception.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="obstacle_router" exec="stable_obstacle_router_node"
        name="stable_obstacle_router" output="screen">
    <param from="$(find-pkg-share obstacle_router)/config/stable_obstacle_router.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Existing static planner, unchanged. Only its subscriber and publisher
       are redirected for this mode. -->
  <node pkg="spline" exec="spline_node" name="spline_node" output="screen">
    <param from="$(var config_dir)/perception.yaml"/>
    <param from="$(var config_dir)/dynamic_perception.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/tracking/obstacles" to="/tracking/static_obstacles"/>
    <remap from="/planner/avoidance/otwpnts" to="/planner/avoidance/static_otwpnts"/>
  </node>

  <!-- The existing updater is the only publisher of global_waypoints_updated. -->
  <node pkg="spline_planner" exec="update_waypoints" name="waypoint_updater" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- /planner/recovery/wpnts had no publisher anywhere in this workspace, so
       the state machine's RECOVERY state could never be entered and a car off
       the raceline was handed the raceline itself, cutting back to it from
       wherever it was. See recovery_node's docstring. -->
  <node pkg="spline_planner" exec="recovery_node" name="recovery_node" output="screen">
    <param name="path_length_m" value="10.0"/>
    <param name="return_distance_m" value="3.0"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <group if="$(var gp_learning)">
    <node pkg="gp_traj_predictor" exec="opponent_trajectory"
          name="opponent_trajectory" output="screen">
      <param from="$(find-pkg-share gp_traj_predictor)/config/prediction.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <remap from="/tracking/obstacles" to="/tracking/dynamic_obstacles"/>
    </node>
    <node pkg="gp_traj_predictor" exec="gaussian_process_opp_traj"
          name="gaussian_process_opp_traj" output="screen">
      <param from="$(find-pkg-share gp_traj_predictor)/config/prediction.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <group if="$(var prediction)">
    <node pkg="gp_traj_predictor" exec="opp_prediction"
          name="opp_prediction" output="screen">
      <param from="$(find-pkg-share gp_traj_predictor)/config/prediction.yaml"/>
      <param name="authorize_on_fallback" value="$(var authorize_on_fallback)"/>
      <!-- 2 s -> 1 s. Constant velocity is a straight line and this track is
           not; extrapolating the opponent two seconds through a corner puts it
           somewhere it will not be. One second is also 3 m at racing speed,
           which is exactly the lane-change planner's prediction_span_m, so the
           span the planner validates and the span the state machine re-checks
           finally cover the same ground - see _planner_validated_span.
           Overridden here rather than in prediction.yaml so gp_learning:=true
           still gets the 2 s horizon the learned profile was tuned for. -->
      <param name="n_time_steps" value="10"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <remap from="/tracking/obstacles" to="/tracking/dynamic_obstacles"/>
    </node>
  </group>

  <group if="$(var dynamic_avoidance)">
    <node pkg="lane_change_planner" exec="change_avoidance_node"
          name="change_avoidance_node" output="screen">
      <param from="$(find-pkg-share lane_change_planner)/config/lane_change_planner.yaml"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <remap from="/tracking/obstacles" to="/tracking/dynamic_obstacles"/>
    </node>
  </group>

  <!-- The wrapper preserves the existing state logic and only corrects the
       head-to-head startup semantics of use_force_trailing. -->
  <node pkg="state_machine" exec="head_to_head_state_machine"
        name="state_machine" output="screen">
    <param from="$(var config_dir)/state_machine_params.yaml"/>
    <!-- Overlay, loaded second so its keys win. Shrinks the horizons to this
         workspace's ~21 m tracks and gives the dynamic avoidance path the
         speed ceiling and cache lifetime the static one already has, without
         editing either shared file. -->
    <param from="$(var config_dir)/head_to_head_state_machine_params.yaml"/>
    <param name="config_dir" value="$(var config_dir)"/>
    <param name="map_dir" value="$(var map_dir)"/>
    <param name="timetrials_only" value="false"/>
    <param name="ot_planner" value="lane_change"/>
    <!-- Kept in step with the argument above so the state machine never offers
         OVERTAKE on a planner that was not launched. -->
    <param name="dynamic_avoidance_enabled" value="$(var dynamic_avoidance)"/>
    <param name="use_force_trailing" value="true"/>
    <!-- Physical width is used only in collision clearance checks. The
         legacy 0.40 m gb_ego_width_m remains the raceline-state tolerance. -->
    <param name="clearance_vehicle_width_m" value="0.28"/>
    <param name="trailing_block_hold_sec" value="0.75"/>
    <param name="trailing_target_hold_sec" value="0.75"/>
    <param name="sim" value="$(var use_sim_time)"/>
    <param name="map" value="$(var map)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/tracking/obstacles" to="/tracking/stable_obstacles"/>
  </node>

  <node pkg="controller" exec="controller_manager" name="controller_manager" output="screen">
    <param from="$(var config_dir)/controller.yaml"/>
    <param from="$(var config_dir)/head_to_head_controller.yaml"/>
    <param name="save_yaml_path" value="$(var config_dir)/controller.yaml"/>
    <param name="sim" value="$(var use_sim_time)"/>
    <param name="single_opponent_mode" value="true"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/imu/data" to="/vesc/sensors/imu/raw"/>
  </node>

  <!-- ===== re-seeding the particle filter ===== -->
  <!-- Two nodes, neither of which the driving stack depends on: kill them
       mid-race and the car keeps driving. relocalizer publishes /initialpose
       at the finish-line waypoint's KNOWN map pose every N laps, which is the
       same path an RViz "2D Pose Estimate" takes, so nothing else changes.
       lap_analyser is here because that is what publishes the lap_data it
       counts - not for the lap times.
       qual_scheduler is deliberately NOT here. It steps the speed schedule up
       partway through a qualifying run, which is not a thing during a race.

       WORTH RE-TESTING NOW. This was a workaround for the particle cloud
       spreading over a run - which is also what a pose reset repaired, taking
       `possible` from 45 straight back to 160. The cause of that spread was
       the motion model's yaw rate coming from the servo command, and all three
       consumers are on the gyro now. If the cloud no longer degrades, the
       re-seed is pure cost: it scatters particles 0.5 m and 0.4 rad around the
       line and the estimate is briefly worse, at racing speed, right where
       the car is committed. A/B it with relocalize:=false. -->
  <group if="$(var relocalize)">
    <node pkg="lap_analyser" exec="lap_analyser" name="lap_analyser" output="screen">
      <param name="lap_start_from_initialpose" value="true"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
    <node pkg="lap_analyser" exec="relocalizer" name="auto_relocalizer" output="screen">
      <param name="relocalize_every_n_laps" value="$(var relocalize_every_n_laps)"/>
      <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
  </group>

  <node pkg="stack_master" exec="simple_mux_node.py" name="simple_mux" output="screen">
    <param name="in_topic" value="/vesc/high_level/ackermann_cmd"/>
    <param name="out_topic" value="/vesc/ackermann_cmd"/>
    <param name="joy_max_speed" value="$(var joy_max_speed)"/>
    <param name="joy_max_steer" value="0.2954"/>
    <param name="steering_angle_to_servo_gain" value="-1.1"/>
    <param name="steering_angle_to_servo_offset" value="0.445"/>
    <param name="servo_min" value="0.12"/>
    <param name="servo_max" value="0.77"/>
    <param name="use_estop" value="false"/>
    <param name="sim" value="$(var use_sim_time)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
