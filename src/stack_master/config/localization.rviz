Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
      Alpha: 0.7
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (m): 0.03
      Style: Points
      Color: 255; 85; 0
      Color Transformer: FlatColor
      Value: true
    # Spread means the filter is unsure. Tight and following the car means it
    # has converged - that is the thing to watch after setting the pose.
    - Class: rviz_default_plugins/PoseArray
      Name: PF particles
      Enabled: true
      Topic:
        Value: /pf/viz/particles
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Shape: Arrow (Flat)
      Color: 0; 170; 255
      Alpha: 0.6
      Arrow Length: 0.15
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: car_state/odom
      Enabled: true
      Topic:
        Value: /car_state/odom
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Keep: 1
      Shape:
        Value: Arrow
        Color: 0; 255; 0
        Shaft Length: 0.4
        Shaft Radius: 0.05
        Head Length: 0.15
        Head Radius: 0.1
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Raceline
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /global_waypoints/markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Qual HUD
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /qual_hud
        Depth: 10
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    # This is what tells the particle filter where the car started.
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 40
      X: 0
      Y: 0
      Angle: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
